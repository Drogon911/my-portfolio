# Шаблон переменных окружения. Скопируй в .env.local и заполни значениями
# из Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — только локально, для скрипта заливки в Storage
# (scripts/upload-to-storage.mjs). НЕ коммитить, НЕ давать в браузер/NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
